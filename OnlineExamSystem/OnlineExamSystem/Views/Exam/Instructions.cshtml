@{
    ViewBag.Title = "Instructions";
}
@model OnlineExamSystem.Models.Exam

<style>
    /* ================= HEADER FIX ================= */

    /* remove white navbar box */
    .navbar .container {
        background: transparent !important;
        box-shadow: none !important;
        border-radius: 0 !important;
    }

    /* full green header */
    .navbar {
        background: linear-gradient(90deg, #556B2F, #6B8E23) !important;
        padding: 12px 0;
    }

        /* navbar text */
        .navbar a,
        .navbar-brand {
            color: white !important;
            font-weight: 500;
        }

            /* hover */
            .navbar a:hover {
                color: #e6f2c8 !important;
            }

    /* remove click highlight */
    .nav-link:focus,
    .nav-link:active {
        background: transparent !important;
        color: #e6f2c8 !important;
    }

    /* ================= PAGE BACKGROUND ================= */

    body {
        font-family: 'Segoe UI', Arial;
        background: #f4f4f4;
    }

    /* ================= MAIN CONTAINER ================= */

    .exam-wrapper {
        text-align: center;
        margin-top: 40px;
    }

    /* ================= TITLE ================= */

    .exam-title {
        font-size: 32px;
        color: #556B2F;
        margin-bottom: 20px;
    }

    /* ================= CARD ================= */

    .exam-card {
        width: 400px;
        margin: auto;
        padding: 25px;
        background: white;
        border-radius: 12px;
        box-shadow: 0 6px 15px rgba(0,0,0,0.2);
    }

        /* info text */
        .exam-card p {
            font-size: 16px;
            margin: 10px 0;
            color: #333;
        }

    /* ================= BUTTON ================= */

    .btn-start {
        display: inline-block;
        margin-top: 20px;
        padding: 10px 25px;
        background: linear-gradient(180deg, #556B2F, #6B8E23);
        color: white;
        border-radius: 6px;
        text-decoration: none;
        font-weight: 500;
        transition: 0.3s;
    }

        .btn-start:hover {
            background: #4c6227;
        }
</style>


<div class="exam-wrapper">

    <div class="exam-title">
        Exam Instructions
    </div>

    <div class="exam-card">

        <p><strong>Total Questions:</strong> @Model.TotalQuestions</p>
        <p><strong>Pass Marks:</strong> @Model.PassMarks</p>
        <p><strong>Duration:</strong> @Model.DurationMinutes Minutes</p>

        <a href="/Exam/StartExam/@Model.ExamId" class="btn-start">
            Start Exam
        </a>

    </div>

</div>
