
@{
    ViewBag.Title = "ResetPassword";
}

@using (Html.BeginForm())
{
    <label>New Password</label>

    <input type="password"
           name="newPassword"
           required />

    <label>Confirm Password</label>

    <input type="password"
           name="confirmPassword"
           required />

    <button type="submit">
        Reset Password
    </button>
}

@ViewBag.Message

