@model IEnumerable<OnlineExamSystem.Models.Question>

@{
    ViewBag.Title = "View Questions";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<style>
    .title {
        font-size: 24px;
        color: #556B2F;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .card {
        background: white;
        border-radius: 16px;
        padding: 20px;
        box-shadow: 0 5px 20px rgba(0,0,0,0.08);
    }

    table {
        width: 100%;
        border-collapse: collapse;
    }

    thead {
        background: linear-gradient(90deg, #556B2F, #6B8E23);
        color: white;
    }

    th, td {
        padding: 12px;
        text-align: left;
    }

    td {
        border-bottom: 1px solid #eee;
        color: #444;
    }

    tr:hover {
        background: #f4f8ee;
    }

    .badge {
        background: #e8f0dc;
        color: #556B2F;
        padding: 5px 10px;
        border-radius: 6px;
        font-size: 12px;
        font-weight: 600;
    }

    .actions {
        display: flex;
        gap: 10px;
    }

    .delete-btn {
        background: #e53935;
        color: white;
        padding: 6px 12px;
        border-radius: 6px;
        text-decoration: none;
    }

        .delete-btn:hover {
            background: #c62828;
        }

    .no-data {
        text-align: center;
        padding: 20px;
        color: #888;
    }

    .filter-bar {
        margin-bottom: 20px;
        display: flex;
        gap: 10px;
    }

    .dropdown {
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #ccc;
    }

    .btn {
        background: #556B2F;
        color: white;
        padding: 10px 15px;
        border-radius: 8px;
        border: none;
        cursor: pointer;
    }
</style>

<h2 class="title">Questions List</h2>

<form method="get" action="@Url.Action("ViewQuestions","Admin")">
    <div class="filter-bar">

        <select name="examId" class="dropdown">
            <option value="">-- Select Exam --</option>

            @foreach (var exam in ViewBag.Exams)
            {
                <option value="@exam.ExamId"
                        @(Request["examId"] == exam.ExamId.ToString() ? "selected" : "")>
                    @exam.ExamName Level @exam.LevelNo
                </option>
            }
        </select>

        <button type="submit" class="btn">Filter</button>

    </div>
</form>

<div class="card">
    <table>
        <thead>
            <tr>
                <th>ID</th>
                <th>Question</th>
                <th>Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (!Model.Any())
            {
                <tr>
                    <td colspan="3" class="no-data">
                        @(Request["examId"] == null
                ? "Please select an exam to view questions"
                : "No questions available for selected exam")
                    </td>
                </tr>
            }
            else
            {
                foreach (var q in Model)
                {
                    <tr>
                        <td>
                            <span class="badge">@q.QuestionId</span>
                        </td>

                        <td>@q.QuestionText</td>

                        <td>
                            <div class="actions">
                                <a href="@Url.Action("DeleteQuestion","Admin", new { id = q.QuestionId })"
                                   class="delete-btn"
                                   onclick="return confirm('Are you sure you want to delete this question?');">
                                    Delete
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            }
        </tbody>
    </table>
</div>