@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<h2 style="color:#556B2F;">Add Questions</h2>

<h3>Add Exam</h3>

<input type="text" id="examName" placeholder="Enter Subject (C#, Java, etc)" class="dropdown" />

<select id="levelNo" class="dropdown">
    <option value="">-- Select Level --</option>
    <option value="1">Level 1</option>
    <option value="2">Level 2</option>
    <option value="3">Level 3</option>
</select>

<button type="button" id="addExamBtn" class="btn">+ Add Exam</button>

<hr />

<select id="examId" class="dropdown">
    <option value="">-- Select Exam --</option>
</select>

<style>
    .dropdown {
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #ccc;
        margin-bottom: 15px;
        width: 250px;
        display: block;
    }

    .question-card {
        background: white;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.1);
        position: relative;
    }

    .option {
        display: flex;
        margin-bottom: 8px;
    }

    .delete-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        background: red;
        color: white;
        border: none;
        cursor: pointer;
    }

    .btn {
        background: #556B2F;
        color: white;
        padding: 10px;
        border-radius: 8px;
        border: none;
        margin-top: 10px;
        cursor: pointer;
    }
</style>

<div id="questions-container">
    <div class="question-card">
        <button type="button" class="delete-btn">❌</button>

        <input type="text" class="question" placeholder="Enter question" />

        <div class="option">
            <input type="radio" name="q1" value="A">
            <input type="text" class="optA" placeholder="Option A">
        </div>

        <div class="option">
            <input type="radio" name="q1" value="B">
            <input type="text" class="optB" placeholder="Option B">
        </div>

        <div class="option">
            <input type="radio" name="q1" value="C">
            <input type="text" class="optC" placeholder="Option C">
        </div>

        <div class="option">
            <input type="radio" name="q1" value="D">
            <input type="text" class="optD" placeholder="Option D">
        </div>
    </div>
</div>

<button type="button" id="addQuestion" class="btn">+ Add Question</button>
<button type="button" id="submitBtn" class="btn">Submit</button>

@section scripts{
    <script>

let questionCount = 1;

$(document).ready(function () {

    loadExams();

    $("#addExamBtn").click(function () {

        let examName = $("#examName").val();
        let levelNo = $("#levelNo").val();

        if (!examName || !levelNo) {
            alert("Enter exam name and level!");
            return;
        }

        $.ajax({
            url: '@Url.Action("AddExam","Admin")',
            type: 'POST',
            data: {
                ExamName: examName,
                LevelNo: levelNo,
                TotalQuestions: 10,
                PassMarks: 6,
                DurationMinutes: 30
            },
            success: function (res) {
                if (res.success) {
                    alert("✅ Exam added");
                    loadExams();
                    $("#examName").val('');
                    $("#levelNo").val('');
                } else {
                    alert(res.message);
                }
            }
        });

    });

    function loadExams() {

        $.get('@Url.Action("GetExams","Admin")', function (data) {

            $("#examId").empty();
            $("#examId").append('<option value="">-- Select Exam --</option>');

            data.forEach(function (e) {
                $("#examId").append(
                    `<option value="${e.ExamId}">
                        ${e.ExamName} Level ${e.LevelNo}
                    </option>`
                );
            });

        });
    }

    $("#addQuestion").click(function () {

        questionCount++;

        let html = `
        <div class="question-card">
            <button type="button" class="delete-btn">❌</button>

            <input type="text" class="question" placeholder="Enter question" />

            <div class="option">
                <input type="radio" name="q${questionCount}" value="A">
                <input type="text" class="optA" placeholder="Option A">
            </div>

            <div class="option">
                <input type="radio" name="q${questionCount}" value="B">
                <input type="text" class="optB" placeholder="Option B">
            </div>

            <div class="option">
                <input type="radio" name="q${questionCount}" value="C">
                <input type="text" class="optC" placeholder="Option C">
            </div>

            <div class="option">
                <input type="radio" name="q${questionCount}" value="D">
                <input type="text" class="optD" placeholder="Option D">
            </div>
        </div>`;

        $("#questions-container").append(html);
    });

    $(document).on("click", ".delete-btn", function () {
        $(this).closest(".question-card").remove();
    });



    $("#submitBtn").click(function () {

    let examId = $("#examId").val();

    if (!examId) {
        alert("Select exam!");
        return;
    }

    let allQuestions = [];
    let isValid = true; 

    $(".question-card").each(function () {

        let q = $(this);

        let questionText = q.find(".question").val();
        let answer = q.find("input[type=radio]:checked").val();

        if (!questionText) {
            alert("Question text is required!");
            isValid = false;
            return false;
        }

        if (!answer) {
            alert("Please select correct answer for every question!");
            isValid = false;
            return false;
        }

        allQuestions.push({
            ExamId: parseInt(examId),
            QuestionText: questionText,
            OptionA: q.find(".optA").val(),
            OptionB: q.find(".optB").val(),
            OptionC: q.find(".optC").val(),
            OptionD: q.find(".optD").val(),
            CorrectAnswer: answer
        });

    });

    if (!isValid) {
        return;
    }

    console.log("Sending:", allQuestions);

    $.ajax({
        url: '@Url.Action("SaveQuestions","Admin")',
        type: 'POST',
        data: JSON.stringify(allQuestions),
        contentType: 'application/json; charset=utf-8',
        success: function (res) {
            if (res.success) {
                alert("Questions saved!");
                location.reload();
            } else {
                alert(res.message);
            }
        }
    });

});


});

    </script>
}