@{
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<h2 style="color:#556B2F;">Add Questions</h2>

@*<select id="examId" class="dropdown">
    <option value="">-- Select Exam --</option>
    <option value="1">C# Level 1</option>
    <option value="2">C# Level 2</option>
    <option value="3">C# Level 3</option>
</select>*@
<select id="examId" class="dropdown">
    <option value="">-- Select Exam --</option>

    @foreach (var exam in ViewBag.Exams)
    {
        <option value="@exam.ExamId">
            @exam.ExamName - Level @exam.LevelNo
        </option>
    }
</select>
<style>
    .dropdown {
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #ccc;
        margin-bottom: 20px;
    }

    .question-card {
        background: white;
        padding: 20px;
        border-radius: 12px;
        margin-bottom: 15px;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        position: relative;
    }

        .question-card input[type="text"] {
            width: 100%;
            padding: 10px;
            margin-bottom: 10px;
            border-radius: 6px;
            border: 1px solid #ddd;
        }

    .option {
        display: flex;
        align-items: center;
        margin-bottom: 8px;
    }

        .option input[type="radio"] {
            margin-right: 10px;
        }

    .delete-btn {
        position: absolute;
        top: 10px;
        right: 10px;
        background: #e53935;
        color: white;
        border: none;
        padding: 5px 10px;
        border-radius: 6px;
        cursor: pointer;
    }

    .btn {
        background: #556B2F;
        color: white;
        padding: 10px 18px;
        border-radius: 8px;
        border: none;
        margin-top: 10px;
        cursor: pointer;
    }

        .btn:hover {
            background: #3e4f22;
        }
</style>

<div id="questions-container">

    <div class="question-card">
        <button class="delete-btn">❌</button>

        <input type="text" class="question" placeholder="Enter question" />

        <div class="option">
            <input type="radio" name="q1" value="A">
            <input type="text" class="optA" placeholder="Option A">
        </div>

        <div class="option">
            <input type="radio" name="q1" value="B">
            <input type="text" class="optB" placeholder="Option B">
        </div>

        <div class="option">
            <input type="radio" name="q1" value="C">
            <input type="text" class="optC" placeholder="Option C">
        </div>

        <div class="option">
            <input type="radio" name="q1" value="D">
            <input type="text" class="optD" placeholder="Option D">
        </div>
    </div>

</div>

<button id="addQuestion" class="btn">+ Add Question</button>
<button id="submitBtn" class="btn">Submit</button>

@section scripts{
    <script>
        $(document).ready(function () {

            let questionCount = 1;

            $("#addQuestion").click(function () {
                questionCount++;

                let html = `
            <div class="question-card">
                <button class="delete-btn">❌</button>

                <input type="text" class="question" placeholder="Enter question" />

                <div class="option">
                    <input type="radio" name="q${questionCount}" value="A">
                    <input type="text" class="optA" placeholder="Option A">
                </div>

                <div class="option">
                    <input type="radio" name="q${questionCount}" value="B">
                    <input type="text" class="optB" placeholder="Option B">
                </div>

                <div class="option">
                    <input type="radio" name="q${questionCount}" value="C">
                    <input type="text" class="optC" placeholder="Option C">
                </div>

                <div class="option">
                    <input type="radio" name="q${questionCount}" value="D">
                    <input type="text" class="optD" placeholder="Option D">
                </div>
            </div>`;

                $("#questions-container").append(html);
            });

            $(document).on("click", ".delete-btn", function () {
                $(this).closest(".question-card").remove();
            });

            $("#submitBtn").click(function () {

                let examId = $("#examId").val();

                if (!examId) {
                    alert("Please select exam!");
                    return;
                }

                let allQuestions = [];
                let valid = true;

                $(".question-card").each(function () {

                    let q = $(this);

                    let questionText = q.find(".question").val();
                    let answer = q.find("input[type=radio]:checked").val();

                    if (!questionText) {
                        alert("Question cannot be empty!");
                        valid = false;
                        return false;
                    }

                    if (!answer) {
                        alert("Select correct answer!");
                        valid = false;
                        return false;
                    }

                    allQuestions.push({
                        ExamId: examId,
                        QuestionText: questionText,
                        OptionA: q.find(".optA").val(),
                        OptionB: q.find(".optB").val(),
                        OptionC: q.find(".optC").val(),
                        OptionD: q.find(".optD").val(),
                        CorrectAnswer: answer
                    });

                });

                if (!valid) return;

                $.ajax({
                    url: '/Admin/SaveQuestions',
                    type: 'POST',
                    data: JSON.stringify(allQuestions),
                    contentType: 'application/json; charset=utf-8',
                    success: function () {
                        alert("✅ Questions saved successfully!");
                        location.reload();
                    },
                    error: function () {
                        alert("❌ Error saving questions!");
                    }
                });

            });

        });
    </script>
}