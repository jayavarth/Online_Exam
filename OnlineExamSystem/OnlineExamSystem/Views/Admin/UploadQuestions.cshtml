@{
    ViewBag.Title = "Upload Questions";
    Layout = "~/Views/Shared/AdminLayout.cshtml";
}

<style>
    .page-title {
        font-size: 24px;
        color: #556B2F;
        margin-bottom: 20px;
        font-weight: 600;
    }

    .upload-card {
        background: white;
        padding: 30px;
        border-radius: 16px;
        max-width: 500px;
        box-shadow: 0 6px 20px rgba(0,0,0,0.08);
    }

    .file-label {
        display: block;
        margin-bottom: 8px;
        font-weight: 500;
        color: #333;
    }

    .file-input {
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        border: 1px solid #ccc;
        margin-bottom: 20px;
    }

    .btn-upload {
        background: #556B2F;
        color: white;
        padding: 10px 18px;
        border-radius: 8px;
        border: none;
        cursor: pointer;
    }

        .btn-upload:hover {
            background: #3e4f22;
        }

    .success-msg {
        margin-top: 15px;
        color: #2e7d32;
        font-weight: 500;
    }

    .note {
        margin-top: 20px;
        font-size: 13px;
        color: #777;
    }
</style>

<h2 class="page-title">📤 Upload Questions (Excel)</h2>

<div class="upload-card">

    @using (Html.BeginForm(
        "UploadQuestions",
        "Admin",
        FormMethod.Post,
        new { enctype = "multipart/form-data" }))
    {
        <label class="file-label">Select Excel File (.xlsx)</label>

        <input type="file"
               name="file"
               accept=".xlsx"
               class="file-input"
               required />

        <button type="submit" class="btn-upload">
            Upload File
        </button>
    }

    <div class="success-msg">
        @ViewBag.Message
    </div>

    <div class="note">
         Excel format:<br><br>
        <b>ExamId | Question | OptionA | OptionB | OptionC | OptionD | Answer</b>
    </div>

</div>
``