
@{
    ViewBag.Title = "ResetPassword";
}

@using (Html.BeginForm())
{
    <label>New Password</label>

    <input type="password"
           name="newPassword"
           required />

    <br />
    <br />

    <label>Confirm Password</label>

    <input type="password"
           name="confirmPassword"
           required />

    <br />
    <br />

    <button type="submit">
        Update Password
    </button>
}

<h3 style="color:red">
    @ViewBag.Message
</h3>

